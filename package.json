{
  "name": "@agentic-sdlc-test/easybuy-api-client",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agentic-SDLC-test/easybuy-api-client.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
